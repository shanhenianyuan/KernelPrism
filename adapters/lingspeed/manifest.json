{
  "vendor_id": "lingspeed",
  "display_name": "Lingspeed LUCA",
  "version": "1.0.0",
  "source": {
    "type": "local",
    "ref": "kernel-prism adapters/lingspeed",
    "url": "https://www.lingspeed.com/"
  },
  "devices": ["lsc1000"],
  "dsls": ["luca"],
  "toolchain_hook": "toolchains/lingspeed-env.sh",
  "perf_baseline_url": "https://www.lingspeed.com/benchmarks/",
  "stages": {
    "v0_understand": {"enabled": true, "hook": null},
    "v1_analyze": {"enabled": true, "hook": null},
    "v2_generate": {"enabled": true, "hook": null, "provider": "generic"},
    "v3_compile": {"enabled": true, "hook": "hooks/compile.py"},
    "v4_verify": {"enabled": true, "hook": "hooks/verify.py"},
    "v5_profile": {"enabled": true, "hook": "hooks/perf.py"},
    "v6_optimize": {"enabled": true, "hook": null},
    "v7_register": {"enabled": true, "hook": null}
  },
  "agents": ["architect", "developer", "tester", "perf_tuner", "qa"],
  "license": {
    "id": "LUCA SDK Proprietary",
    "restrictions": ["lingspeed-device-only", "no-sublicense", "proprietary"],
    "install_consent_required": true
  },
  "entrypoints": {
    "probe": "hooks/probe.py",
    "status": "hooks/status.py"
  }
}
